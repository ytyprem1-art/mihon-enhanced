import kotlin.time.Instant;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL UNIQUE,
    read_at INTEGER AS Instant,
    read_duration INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapter (id)
    ON DELETE CASCADE
);

CREATE INDEX history_manga_id_index ON history(manga_id);
CREATE INDEX history_read_at_index ON history(read_at);

getHistoryByMangaId:
SELECT id, chapter_id, read_at, read_duration
FROM history
WHERE manga_id = :mangaId;

resetHistoryById:
UPDATE history
SET read_at = NULL
WHERE id = :id;

resetHistoryByMangaId:
UPDATE history
SET read_at = NULL
WHERE manga_id = :mangaId;

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE read_at IS NULL;

upsert:
INSERT INTO history(manga_id, chapter_id, read_at, read_duration)
SELECT manga_id, id, :readAt, :readDuration
FROM chapter
WHERE id = :chapterId
ON CONFLICT(chapter_id) DO UPDATE SET
    read_at = excluded.read_at,
    read_duration = read_duration + excluded.read_duration;

getReadDuration:
SELECT coalesce(sum(read_duration), 0)
FROM history;

getHistoryByChapterId:
SELECT id, chapter_id, read_at, read_duration
FROM history
WHERE chapter_id = :chapterId;


deleteHistoryByChapterId:
DELETE FROM history
WHERE chapter_id = :chapterId;


getLatestHistoryByMangaId:
SELECT
H.id AS historyId,
M.id AS mangaId,
C.id AS chapterId,
M.remote_title,
M.remote_cover AS thumbnailUrl,
M.source_id AS sourceId,
M.user_favorite_at IS NOT NULL AS isFavorite,
M.state_cover_last_modified AS coverLastModified,
C.remote_chapter_number AS chapterNumber,
H.read_at AS readAt,
H.read_duration AS readDuration
FROM history H
JOIN chapter C ON H.chapter_id = C.id
JOIN manga M ON C.manga_id = M.id
WHERE M.id = :mangaId
ORDER BY H.read_at DESC
LIMIT 1;

getHistoryByChapterUrlAndMangaId:
SELECT
H.id,
H.chapter_id,
H.read_at,
H.read_duration
FROM history H
JOIN chapter C
ON H.chapter_id = C.id
WHERE C.remote_url = :chapterUrl AND C.manga_id = :mangaId AND C.id = H.chapter_id
ORDER BY H.id ASC
LIMIT 1;

