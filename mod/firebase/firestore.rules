rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasPanel(data) {
      return 'hasPanel' in data && data.hasPanel == true;
    }

    function hasGif(data) {
      return 'hasGif' in data && data.hasGif == true;
    }
    function gifLink(data) {
      return 'gifUrl' in data;
    }

    match /global_chat/{messageId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.text is string
        && request.resource.data.isMangaShare is bool
        && request.resource.data.timestamp == request.time
        && (!hasGif(request.resource.data) || (
          !hasPanel(request.resource.data)
          && request.resource.data.isMangaShare == false
          && request.resource.data.text.size() <= 200
          && request.resource.data.gifWidth is int && request.resource.data.gifWidth > 0 && request.resource.data.gifWidth <= 1200
          && request.resource.data.gifHeight is int && request.resource.data.gifHeight > 0 && request.resource.data.gifHeight <= 1200
          && (gifLink(request.resource.data)
            ? (request.resource.data.gifUrl is string && request.resource.data.gifUrl.size() <= 2000
              && request.resource.data.gifUrl.matches('https://(media[.]tenor[.]com|media[0-9]*[.]giphy[.]com|i[.]giphy[.]com)/[^?#]*[.][gG][iI][fF]([?].*)?'))
            : getAfter(/databases/$(database)/documents/global_chat_gifs/$(messageId)).data.senderUid == request.auth.uid)
        ))
        && (!hasPanel(request.resource.data) || (
          request.resource.data.isMangaShare == true
          && request.resource.data.text.size() <= 200
          && request.resource.data.panelWidth is int
          && request.resource.data.panelWidth > 0
          && request.resource.data.panelWidth <= 800
          && request.resource.data.panelHeight is int
          && request.resource.data.panelHeight > 0
          && request.resource.data.panelHeight <= 800
          && getAfter(/databases/$(database)/documents/global_chat_panels/$(messageId)).data.senderUid == request.auth.uid
        ));

      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && (
          ('readBy' in resource.data && resource.data.readBy is map)
            ? request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
            : request.resource.data.readBy.keys().hasOnly([request.auth.uid])
        );

      // Clients retain the newest 200 messages. Rules cannot count an ordered query.
      // Only authenticated chat clients may delete, and a panel must be deleted in the same batch.
      allow delete: if isAuthenticated()
        && (!hasGif(resource.data) || gifLink(resource.data)
          || !existsAfter(/databases/$(database)/documents/global_chat_gifs/$(messageId)))
        && (!hasPanel(resource.data)
          || !existsAfter(/databases/$(database)/documents/global_chat_panels/$(messageId)));
    }

    match /global_chat_panels/{messageId} {
      allow read: if isAuthenticated()
        && hasPanel(get(/databases/$(database)/documents/global_chat/$(messageId)).data);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['senderUid', 'data'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.data is bytes
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 150000
        && hasPanel(getAfter(/databases/$(database)/documents/global_chat/$(messageId)).data)
        && getAfter(/databases/$(database)/documents/global_chat/$(messageId)).data.senderUid == request.auth.uid;

      allow update: if false;
      allow delete: if isAuthenticated()
        && !existsAfter(/databases/$(database)/documents/global_chat/$(messageId));
    }

    match /global_chat_gifs/{messageId} {
      allow read: if isAuthenticated()
        && hasGif(get(/databases/$(database)/documents/global_chat/$(messageId)).data)
        && !gifLink(get(/databases/$(database)/documents/global_chat/$(messageId)).data);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['senderUid', 'data'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.data is bytes
        && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 1000000
        && hasGif(getAfter(/databases/$(database)/documents/global_chat/$(messageId)).data)
        && !gifLink(getAfter(/databases/$(database)/documents/global_chat/$(messageId)).data)
        && getAfter(/databases/$(database)/documents/global_chat/$(messageId)).data.senderUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated()
        && !existsAfter(/databases/$(database)/documents/global_chat/$(messageId));
    }

    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // The tiny avatar stays in presence; the larger photo is fetched only when opened.
    match /chat_profile_photos/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['senderUid', 'version', 'width', 'height', 'data'])
        && request.resource.data.senderUid == userId
        && request.resource.data.version is string
        && request.resource.data.version.matches('[0-9a-f-]{36}')
        && request.resource.data.width == 768 && request.resource.data.height == 768
        && request.resource.data.data is bytes
        && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 204800
        && getAfter(/databases/$(database)/documents/presence/$(userId)).data.avatarPhotoVersion == request.resource.data.version;
      allow delete: if isOwner(userId)
        && !('avatarPhotoVersion' in getAfter(/databases/$(database)/documents/presence/$(userId)).data);
    }

    // The shared password verifier is provisioned through Console/Admin SDK only.
    // Neither it nor password proofs are readable by Android clients.
    match /mod_update_config/{document} {
      allow read, write: if false;
    }
    match /mod_update_proofs/{userId} {
      allow read, delete: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['pinHash', 'at', 'version', 'fileId', 'notes', 'releaseNumber', 'publishedAt'])
        && request.resource.data.at == request.time
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash == get(/databases/$(database)/documents/mod_update_config/admin).data.pinHash;
    }

    match /mod_updates/{channel} {
      allow get: if channel == 'stable';
      allow list, delete: if false;
      allow create, update: if channel == 'stable' && isAuthenticated()
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.pinHash
            == get(/databases/$(database)/documents/mod_update_config/admin).data.pinHash
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.at == request.time
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.version == request.resource.data.version
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.fileId == request.resource.data.fileId
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.notes == request.resource.data.notes
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.releaseNumber == request.resource.data.releaseNumber
        && request.resource.data.keys().hasOnly(['version', 'fileId', 'notes', 'releaseNumber', 'publishedAt'])
        && request.resource.data.version is string
        && request.resource.data.version.matches('[0-9]{1,3}[.][0-9]{1,3}([.][0-9]{1,3})?')
        && request.resource.data.fileId is string
        && request.resource.data.fileId.matches('[A-Za-z0-9_-]{10,150}')
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 4000
        && request.resource.data.releaseNumber is int && request.resource.data.releaseNumber > 0
        && request.resource.data.publishedAt == request.time
        && getAfter(/databases/$(database)/documents/mod_update_releases/$(request.resource.data.version)).data == request.resource.data
        && (!exists(/databases/$(database)/documents/mod_updates/$(channel))
            || request.resource.data.releaseNumber >= resource.data.releaseNumber);
    }
    match /mod_update_releases/{version} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if isAuthenticated()
        && version == request.resource.data.version
        && request.resource.data.publishedAt == request.time
        && getAfter(/databases/$(database)/documents/mod_updates/stable).data == request.resource.data
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.at == request.time
        && getAfter(/databases/$(database)/documents/mod_update_proofs/$(request.auth.uid)).data.pinHash
          == get(/databases/$(database)/documents/mod_update_config/admin).data.pinHash;
    }
  }
}
